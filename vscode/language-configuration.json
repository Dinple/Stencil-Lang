{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]],
  "wordPattern": "[A-Za-z_][\\w]*|[0-9]+(?:\\.[0-9]+)?(?:nm|um)?",
  "indentationRules": {
    "increaseIndentPattern": "\\{[^}\"]*$",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "onEnterRules": []
}
