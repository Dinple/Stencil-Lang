{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Stencil",
  "scopeName": "source.stencil",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#header" },
    { "include": "#import" },
    { "include": "#patch" },
    { "include": "#object" },
    { "include": "#attribute" },
    { "include": "#function" },
    { "include": "#keyword" },
    { "include": "#literal" },
    { "include": "#number" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": { "match": "#.*$", "name": "comment.line.number-sign.stencil" },
    "string": {
      "begin": "\"", "end": "\"", "name": "string.quoted.double.stencil",
      "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.stencil" }]
    },
    "header": {
      "match": "^\\s*(stencil)\\s+([0-9]+(?:\\.[0-9]+)*)",
      "captures": { "1": { "name": "keyword.control.stencil" }, "2": { "name": "constant.numeric.version.stencil" } }
    },
    "import": {
      "match": "\\b(import)\\b\\s*(\"[^\"]*\")?\\s*(?:\\b(as)\\b\\s*([A-Za-z_]\\w*))?",
      "captures": {
        "1": { "name": "keyword.control.import.stencil" },
        "2": { "name": "string.quoted.double.stencil" },
        "3": { "name": "keyword.control.import.stencil" },
        "4": { "name": "entity.name.namespace.stencil" }
      }
    },
    "patch": {
      "match": "(&)\\s*([A-Za-z_][\\w.]*)",
      "captures": { "1": { "name": "keyword.operator.patch.stencil" }, "2": { "name": "entity.name.type.patched.stencil" } }
    },
    "object": {
      "match": "\\b([A-Za-z_]\\w*)(?:\\s+([A-Za-z_]\\w*))?(?=\\s*\\{)",
      "captures": { "1": { "name": "storage.type.kind.stencil" }, "2": { "name": "entity.name.object.stencil" } }
    },
    "attribute": { "match": "\\b([A-Za-z_]\\w*)(?=\\s*=(?!=))", "captures": { "1": { "name": "variable.other.property.stencil" } } },
    "function": { "match": "\\b([A-Za-z_]\\w*)(?=\\s*\\()", "captures": { "1": { "name": "entity.name.function.stencil" } } },
    "keyword": { "match": "\\b(stencil|import|as|drop)\\b", "name": "keyword.control.stencil" },
    "literal": { "match": "\\b(true|false|none|required)\\b", "name": "constant.language.stencil" },
    "number": { "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:nm|um)?\\b", "name": "constant.numeric.stencil" },
    "operator": { "match": "\\.\\.|==|!=|<=|>=|[=+\\-*/<>]", "name": "keyword.operator.stencil" }
  }
}
