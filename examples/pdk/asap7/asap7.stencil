rule NSELECT_EN_X { kind = enclosure; on = [ACTIVE, NSELECT]; axis = x; value = 46nm }   # DRC:1450-1458
rule NSELECT_EN_Y { kind = enclosure; on = [ACTIVE, NSELECT]; axis = y; value = 27nm }   # DRC:1450-1458
rule PSELECT_EN_X { kind = enclosure; on = [ACTIVE, PSELECT]; axis = x; value = 46nm }   # DRC:1496-1504
