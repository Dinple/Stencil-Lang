rule PSELECT_GATE_EX_X { kind = extension; axis = x; on = [PSELECT, GATE]; value = 7nm }   # DRC:1520-1528
rule PSELECT_GATE_EX_Y { kind = extension; axis = y; on = [PSELECT, GATE]; value = 7nm }   # DRC:1520-1528
rule LVT_GATE_EX_X     { kind = extension; axis = x; on = [LVT, GATE];     value = 7nm }   # DRC:1617-1624
rule LVT_GATE_EX_Y     { kind = extension; axis = y; on = [LVT, GATE];     value = 7nm }   # DRC:1617-1624
