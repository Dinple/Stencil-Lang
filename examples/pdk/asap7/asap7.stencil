rule SLVT_EN_X    { kind = enclosure; on = [ACTIVE, SLVT];    axis = x; value = 46nm }   # DRC:1547-1555
rule SLVT_EN_Y    { kind = enclosure; on = [ACTIVE, SLVT];    axis = y; value = 27nm }   # DRC:1547-1555
rule SRAMVT_EN_X  { kind = enclosure; on = [ACTIVE, SRAMVT];  axis = x; value = 46nm }   # DRC:1638-1646
