# -- SDT / LISD / LIG
rule SDT_W_X   { kind = width;   on = SDT; axis = x; value = 24nm }   # DRC:1706-1713
rule SDT_W_Y   { kind = width;   on = SDT; axis = y; value = 27nm }   # DRC:1706-1713
rule SDT_S   { kind = spacing; on = SDT; value = 30nm }                                                       # DRC:1754-1755
rule SDT_GATE_S { kind = spacing; on = [SDT, GATE]; value = 5nm }                                             # DRC:1760-1761
rule LISD_W  { kind = width;   on = LISD; value = 24nm }                                                      # DRC:1818-1819
rule LISD_S  { kind = spacing; on = LISD; value = 18nm; prl = 36nm; note = "side-to-side: both edges > 36nm (DRC:224)" }  # DRC:1824-1826
rule LISD_EOL { kind = x_eol_tip; on = LISD; width_below = 36nm                                             # DRC:224-227 edge classes
  case tip_to_side      { value = 25nm }                                                                      # DRC:1831-1833
  case tip_to_tip_wide  { value = 27nm }                                                                      # DRC:1838-1841
  note = "deck: tip = edge length <= 36nm (std/0 does not define < vs <=)" }
rule LISD_A  { kind = area; on = LISD; value = 648nm * 1nm }                                           # DRC:1854-1855
rule LIG_W   { kind = width;   on = LIG; value = 16nm }                                                       # DRC:1868-1869
rule LIG_S   { kind = spacing; on = LIG; value = 18nm; prl = 36nm; note = "side-to-side: both edges > 36nm (DRC:229)" }   # DRC:1874-1876
rule LIG_EOL { kind = x_eol_tip; on = LIG; width_below = 36nm                                               # DRC:229-232
  case tip_to_side       { value = 25nm }                                                                     # DRC:1881-1883
  case tip_to_tip_wide   { value = 27nm }                                                                     # DRC:1888-1891
  case tip_to_tip_narrow { value = 31nm }                                                                     # DRC:1896-1907 (narrow = edge < 24nm)
}
rule LIG_LISD_S { kind = spacing; on = [LIG, LISD]; value = 14nm; same_net = false }                          # DRC:1912-1914
rule LIG_SDT_S  { kind = spacing; on = [LIG, SDT];  value = 14nm; same_net = false }                          # DRC:1926-1928
rule LIG_GATE_S_Y { kind = spacing; on = [LIG, GATE]; axis = y; value = 14nm }   # DRC:1933-1943
rule LIG_GATE_S_X { kind = spacing; on = [LIG, GATE]; axis = x; value = 17nm   # DRC:1933-1943
                  note = "to GATE not cut by GCUT" }
rule LIG_GCUT_S { kind = spacing; on = [LIG, GCUT]; value = 5nm }                                             # DRC:1956-1957
rule LIG_A      { kind = area; on = LIG; value = 324nm * 1nm }                                         # DRC:1963-1964
rule LIG_GATE_EX { kind = extension; axis = x; on = [LIG, GATE]; value = 1nm; note = "on both opposite sides" }         # DRC:2007-2009

# -- V0 / M1
rule V0_W  { kind = width; on = V0; value = 18nm }                                                            # DRC:2030-2031
rule V0_S  { kind = x_via_track_spacing; on = V0                                                                      # DRC:2038-2041 (description)
  case same_track         { value = 18nm }
  case parallel_unaligned { value = 27nm }
  case parallel_aligned   { value = 18nm }
  note = "DRC code (DRC:2047-2050) checks derived V0 masks at 17/18nm; the description and the code differ" }
rule V0_M1_EN   { kind = x_end_cap_enclosure; on = [V0, M1]; case end_cap { value = 5nm }; case side { value = 0nm }    # DRC:2077-2085
                  note = "5&5 or 5&0 on the two ends along M1; side = 0 (DRC:2145 V0 as wide as M1)" }
rule V0_LISD_EN { kind = enclosure; on = [V0, LISD]; value = 3nm; note = "on at least two opposite sides" }  # DRC:2090-2095
rule M1_W   { kind = width;   on = M1; value = 18nm }                                                         # DRC:2151-2152; TLEF:93
rule M1_S   { kind = spacing; on = M1; value = 18nm; prl = 36nm; note = "side-to-side: both edges > 36nm (DRC:376)" }   # DRC:2156-2158; TLEF:94
rule M1_EOL { kind = x_eol_tip; on = M1; width_below = 36nm                                                 # DRC:379-387
  case tip_to_side       { value = 25nm }                                                                     # DRC:2163-2165
  case tip_to_tip_wide   { value = 27nm }                                                                     # DRC:2169-2171
  case tip_to_tip_narrow { value = 31nm }                                                                     # DRC:2175-2184
}
rule M1_A   { kind = area; on = M1; value = 504nm * 1nm; note = "TLEF:95 says 666nm^2 (0.000666um^2); the DRC value wins (TLEF:96: area 'should not matter')" }  # DRC:2193-2194

# -- V1 / M2 / V2 / M3 (DRC M2 and M3 rules are copies of M1)
rule V1_W   { kind = width; on = V1; value = 18nm }                                                           # DRC:2293-2294; TLEF:109
rule V1_S   { kind = x_via_track_spacing; on = V1                                                                     # DRC:2301-2304
  case same_track { value = 18nm }; case parallel_unaligned { value = 27nm }; case parallel_aligned { value = 18nm } }
rule V1_M1_EN { kind = x_end_cap_enclosure; on = [V1, M1]; case end_cap { value = 5nm }; case other_end { value = 2nm } }  # DRC:2339-2342
rule V1_M2_EN { kind = x_end_cap_enclosure; on = [V1, M2]; case end_cap { value = 5nm }; case side { value = 0nm } }      # DRC:2346-2354
rule M2_W   { kind = width;   on = M2; value = 18nm }                                                         # DRC:2198-2199; TLEF:115
rule M2_S   { kind = spacing; on = M2; value = 18nm; prl = 36nm }                                             # DRC:2203-2205; TLEF:116
rule M2_EOL { kind = x_eol_tip; on = M2; width_below = 36nm                                                 # DRC:377-386
  case tip_to_side { value = 25nm }; case tip_to_tip_wide { value = 27nm }; case tip_to_tip_narrow { value = 31nm }   # DRC:2210-2231
  note = "TLEF:141-143 encodes this as LEF58 'SPACING 0.018 ENDOFLINE 0.025 WITHIN 0.02 ENDTOEND 0.031 PARALLELEDGE 0.025 WITHIN 0.02'" }
rule M2_A   { kind = area; on = M2; value = 504nm * 1nm; note = "TLEF:125 says 666" }                           # DRC:2240-2241
rule M2_LEN { kind = min_length; on = M2; value = 37nm; note = "TLEF MINSIZE 0.037 0.018 (length x width)" }  # TLEF:126
rule V2_W   { kind = width; on = V2; value = 18nm }                                                           # DRC:2370-2371; TLEF:174
rule V2_M2_EN { kind = enclosure; on = [V2, M2]; value = 5nm; note = "5 & 5 on opposite sides" }              # DRC:2414-2419
rule V2_M3_EN { kind = x_end_cap_enclosure; on = [V2, M3]; case end_cap { value = 5nm }; case side { value = 0nm } }   # DRC:2421-2431
rule M3_W   { kind = width;   on = M3; value = 18nm }                                                         # DRC:2245-2246; TLEF:182
rule M3_S   { kind = spacing; on = M3; value = 18nm; prl = 36nm }                                             # DRC:2250-2252; TLEF:183
rule M3_EOL { kind = x_eol_tip; on = M3; width_below = 36nm                                                 # DRC:378-387
  case tip_to_side { value = 25nm }; case tip_to_tip_wide { value = 27nm }; case tip_to_tip_narrow { value = 31nm } }  # DRC:2257-2278
rule M3_A   { kind = area; on = M3; value = 504nm * 1nm; note = "TLEF:190 says 666" }                           # DRC:2287-2288
rule M3_LEN { kind = min_length; on = M3; value = 37nm }                                                      # TLEF:191 MINSIZE

# -- V3 .. Pad: from TLEF only (the DRC rules above M3 are grid/decomposition checks, mostly not expressible)
rule V3_S   { kind = cut_spacing; on = V3; value = 34nm }                                                     # TLEF:237 SPACINGTABLE DEFAULT 0.034
rule V3_M4_EN { kind = enclosure; on = [V3, M4]; value = 11nm; note = "on two opposite sides" }               # DRC:2498-2503
rule M4_S   { kind = spacing; on = M4                                                                         # TLEF:287-290 SPACINGTABLE
  table { width = [0nm, 25nm]; prl = [0nm]; values = [[24nm], [72nm]] } }
rule M4_EOL { kind = eol_spacing; on = M4; width_below = 25nm; within = 40nm; value = 24nm                    # TLEF:269-270
  note = "LEF58: SPACING 0.024 ENDOFLINE 0.025 WITHIN 0.04 ENDTOEND 0.04 (ENDTOEND has no std/0 slot)" }
rule M4_A   { kind = area; on = M4; value = 2000nm * 1nm; note = "(TLEF 0.002um^2)" }                            # TLEF:267
rule V4_S   { kind = cut_spacing; on = V4; value = 34nm }                                                     # TLEF:320
rule M5_S   { kind = spacing; on = M5
  table { width = [0nm, 25nm]; prl = [0nm]; values = [[24nm], [72nm]] } }                                     # TLEF:372-375
rule M5_EOL { kind = eol_spacing; on = M5; width_below = 25nm; within = 40nm; value = 24nm }                  # TLEF:351-352
rule M5_A   { kind = area; on = M5; value = 2000nm * 1nm }                                             # TLEF:349
rule V5_S   { kind = cut_spacing; on = V5; value = 34nm }                                                     # TLEF:400
rule M6_S   { kind = spacing; on = M6
  table { width = [0nm, 33nm]; prl = [0nm]; values = [[32nm], [72nm]] } }                                     # TLEF:453-456
rule M6_EOL { kind = eol_spacing; on = M6; width_below = 37.5nm; within = 40nm; value = 32nm }                # TLEF:438-439
rule M6_A   { kind = area; on = M6; value = 2187.5nm * 1nm; note = "(TLEF 0.0021875um^2)" }                      # TLEF:436
rule V6_S   { kind = cut_spacing; on = V6; value = 34nm }                                                     # TLEF:481
rule M7_S   { kind = spacing; on = M7
  table { width = [0nm, 33nm]; prl = [0nm]; values = [[32nm], [72nm]] } }                                     # TLEF:529-532
rule M7_EOL { kind = eol_spacing; on = M7; width_below = 37.5nm; within = 40nm; value = 30nm                  # TLEF:511-512
  note = "30nm here vs 32nm for M6 (TLEF:439) and SPACING 0.032 (TLEF:507): kept as written" }
rule M7_A   { kind = area; on = M7; value = 2187.5nm * 1nm }                                           # TLEF:509
rule V7_S   { kind = cut_spacing; on = V7; value = 46nm }                                                     # TLEF:546
rule M8_S   { kind = spacing; on = M8                                                                         # TLEF:557-564
  table {
    width  = [0nm, 59.75nm, 79.75nm, 119.75nm, 499.75nm, 999.75nm]
    prl    = [0nm, 399.75nm, 1199.75nm, 1799.75nm]
    values = [[40nm, 40nm, 40nm, 40nm], [40nm, 40nm, 40nm, 40nm], [40nm, 40nm, 40nm, 40nm],
              [40nm, 40nm, 40nm, 40nm], [40nm, 40nm, 40nm, 500nm], [40nm, 40nm, 40nm, 1000nm]]
  } }
rule M8_A   { kind = area; on = M8; value = 7520nm * 1nm }                                             # TLEF:555
rule V8_S   { kind = cut_spacing; on = V8; value = 57nm }                                                     # TLEF:574
rule M9_S   { kind = spacing; on = M9                                                                         # TLEF:586-593
  table {
    width  = [0nm, 59.75nm, 79.75nm, 119.75nm, 499.75nm, 999.75nm]
    prl    = [0nm, 399.75nm, 1199.75nm, 1799.75nm]
    values = [[40nm, 40nm, 40nm, 40nm], [40nm, 40nm, 40nm, 40nm], [40nm, 40nm, 40nm, 40nm],
              [40nm, 40nm, 40nm, 40nm], [40nm, 40nm, 40nm, 500nm], [40nm, 40nm, 40nm, 1000nm]]
  } }
rule M9_A   { kind = area; on = M9; value = 7520nm * 1nm }                                             # TLEF:584
rule V9_S   { kind = cut_spacing; on = V9; value = 57nm }                                                     # TLEF:601
rule PAD_S  { kind = spacing; on = Pad                                                                        # TLEF:610-613
  table { width = [0nm, 11999.75nm]; prl = [0nm, 11999.75nm]; values = [[2000nm, 2000nm], [2000nm, 3000nm]] } }

# =============================================================================
# Extensions: facts std/0 has no slot for, kept as structured data so a tool
# can see them. Each one produces a W001 warning (expected).
# =============================================================================
x_asap7_rule M1_CORNER {          # DRC:2186-2189; DRC:2235 (M2), DRC:2282 (M3)
  x_kind = corner_spacing; x_on = [M1, M2, M3]; x_value = 20nm
  note = "std/0 has no corner-to-corner rule kind, and rule.kind rejects x_* names (vocab.js enum), although VOCABULARY.md 2.9 allows them"
}
x_asap7_rule VT_EXCLUSIVE {       # DRC:1672-1677 VT.AUX.2; DRC:1530-1533 NSELECT.PSELECT.AUX.1
  x_kind = must_not_overlap; x_on = [LVT, SLVT, SRAMVT]
  note = "Vt markers are mutually exclusive; NSELECT and PSELECT may not overlap"
}
x_asap7_variant VT_FLAVOURS {     # GSUM_L:18, GSUM_SL:18, GSUM_SRAM:19; CDL_*:33,37
  note = "R/L/SL/SRAM libraries share identical geometry (GINV vs gds_L_INVx1: one extra line). A variant adds ONE marker shape equal to BOUNDARY (none for R) and renames the models. Cell-name suffix _R/_L/_SL/_SRAM (CLEF MACRO names)."
}

# =============================================================================
# LEF scaling (task item 2).
# The '4x' LEF is the same integer geometry read at a different DBU:
#   GDS: 1 DBU = 0.25nm (GSUM:1); INVx1 is 648 x 1080 DBU = 162 x 270 nm (GINV:51).
#   CLEF4:10036 INVx1 SIZE 0.648 BY 1.08 (um) = the same integers read as 1nm.
#   CLEF:9918 SIZE 0.162 BY 0.27 = the real size. TLEF4:120 M1 PITCH 0.144 = 4 x TLEF:92.
# With grid = 0.25nm, the resolved form's integer DBUs equal the GDS integers
# and the 4x-LEF numbers in nm. So 'export 4x' only means "write 1 DBU as 1nm".
# That is a consumer/export setting, not technology. In std/0 it can only be
# carried as an extension on a tool profile:
profile innovus_asap7_4x {
  directions = [horizontal, vertical]
  needs_tracks = true
  x_lef_scale = 4                 # TLEF4 vs TLEF; CLEF4 vs CLEF; qrc/qrcTechFile_typ03_scaled4xV06 vs _unscaledV02
  note = "APR flow uses 4x LEF + 4x qrc. Tools must scale back by 1/4 to get silicon dimensions. directions lists no none, so a profile checker should flag bidirectional M1/LIG (the playground has no profile checker yet)."
}
