rule NSELECT_GATE_EX_X { kind = extension; axis = x; on = [NSELECT, GATE]; value = 7nm }   # DRC:1474-1482 (VAR_OPT_MISALI DRC:275; vertical uses VAR_OPT_EUV_MISALI_GRDBND = 7nm, DRC:277)
