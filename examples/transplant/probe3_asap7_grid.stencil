stencil 0.1
# PROBE3 transistors under the ASAP7 routing grid.
#
# The metals, from M1 up to the pad layer, come from ASAP7. The device tier
# (fins, gates, local interconnect, contacts, the cell template) comes from
# block A or block B below; exactly one of them is active.
#
#   A  the transplant: PROBE3 devices (45 nm gates, a row of 6 ASAP7 tracks)
#   B  the original:   ASAP7's own devices (54 nm gates, a 270 nm row)
#
# To switch, select block A and press Ctrl+/ (comment it out), then select
# block B and press Ctrl+/ again.

technology { grid = 0.25nm; stack = [dev, fs, beol] }   # ASAP7 needs 0.25 nm, PROBE3 0.5 nm

import "../pdk/asap7/frontside" as fs   { CPP = dev.CPP }   # in-cell M1 follows the device's gate grid
import "../pdk/asap7/beol"      as beol { BELOW = fs.M3 }

layer BOUNDARY { role = marker; gds = [100, 0] }   # the cell outline

# ---- A: the transplant, PROBE3 devices ---------------------------------------------
RT = 4                                   # signal tracks per cell, as in PROBE3
import "../pdk/probe3/device" as dev { LANDING = fs.M1; BOUNDARY = BOUNDARY
                                       H_ROW = (RT + 2) * fs.MP }   # 2 tracks for the rails, as in PROBE3
&dev.CORE {                              # ASAP7-style template: rails on M1, signal tracks on M2
  rail VDD { layer = fs.M1; edge = top;    width = 18nm }
  rail VSS { layer = fs.M1; edge = bottom; width = 18nm }
  pins = [fs.M1, fs.M2]
  tracks M2 { use = 1..RT }
}
check ROW_TRACKS      { holds = mod(dev.H_ROW, fs.MP) == 0nm
                        message = "the row height is not a whole number of ASAP7 track pitches" }
check M1_ON_GATE_GRID { holds = dev.CPP >= fs.M1_W.value + fs.M1_S.value
                        message = "in-cell M1 lines one gate pitch apart break the M1 width plus spacing" }

# ---- B: the original, ASAP7 devices ------------------------------------------------
# import "../pdk/asap7/device" as dev { LANDING = fs.M1; BOUNDARY = BOUNDARY }
# &dev.asap7sc7p5t {                     # ASAP7's own template
#   rail VDD { layer = fs.M1; edge = top;    width = 18nm }
#   rail VSS { layer = fs.M1; edge = bottom; width = 18nm }
#   pins = [fs.M1, fs.M2]
#   tracks M2 { use = 1..6 }
# }
