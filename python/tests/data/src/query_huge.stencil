stencil 0.1
# Thresholds with thousands of digits (Python's integer-string limit).
technology { grid = 1nm }
layer A { role = conductor }
layer B { role = conductor }
layer C { role = conductor }
rule AW { kind = width; on = A; value =  }
rule BW { kind = width; on = B; limit = exact; value = 0. }
rule CN { kind = width; on = C; value =  }
rule CX { kind = width; on = C; limit = max; value = 1nm }
